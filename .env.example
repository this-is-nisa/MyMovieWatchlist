# Server-only. Used by the Vite dev proxy and the Netlify function.
# Do not prefix this with VITE_. It must not be exposed to the browser.
TMDB_API_KEY=

# Public Supabase values. Vite embeds any VITE_ variable into the frontend
# at build time, which is expected for the anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
